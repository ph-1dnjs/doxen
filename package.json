{
  "name": "@unana_dev/doxen",
  "version": "0.2.2",
  "description": "Config-first Markdown documentation sites with Korean and section search",
  "type": "module",
  "bin": {
    "docs": "bin/docs.js",
    "doxen": "bin/docs.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "client",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node bin/docs.js dev --config examples/docs.config.ts",
    "build": "node bin/docs.js build --config examples/docs.config.ts",
    "check": "node --check bin/docs.js && node --check client/app.js && npm test",
    "test:browser": "playwright test",
    "test:package": "node e2e/package-smoke.js"
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "jiti": "^2.6.1",
    "jose": "^6.2.12",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "sanitize-html": "^2.17.0",
    "wrangler": "4.149.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph-1dnjs/doxen.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
